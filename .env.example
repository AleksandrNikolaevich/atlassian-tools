# Настройки atlassian-tools. Скопируйте в .env в корне проекта и заполните.
# Файл .env добавьте в .gitignore: в нём пароли.

# ── Confluence ──
WIKI_URL=https://wiki.example.com

# Доступ — один из способов (используется первый заданный):
WIKI_USER=
WIKI_PASSWORD=
# WIKI_TOKEN=
# WIKI_COOKIE=JSESSIONID=

# Что выгружать: всё пространство…
WIKI_SPACE=KEY
# …или только эти страницы с дочерними (тогда WIKI_SPACE не нужен):
# WIKI_ROOTS=123456,234567
# Страницы, которые не выгружать, вместе с дочерними:
# WIKI_EXCLUDE=345678

# Папки от корня проекта:
# WIKI_DIR=wiki
# WIKI_EDIT_DIR=_wiki-edit

# ── Jira ──
JIRA_URL=https://jira.example.com
JIRA_PROJECT=PROJ

# Доступ — если учётная запись та же, что в вики, ничего не вписывайте:
# JIRA_USER=
# JIRA_PASSWORD=
# JIRA_TOKEN=
# JIRA_COOKIE=JSESSIONID=

# Какие релизы выгружать: все невыпущенные и столько последних выпущенных:
# JIRA_RELEASED=5
# Только релизы с подходящим названием (регулярное выражение):
# JIRA_VERSIONS=
# Вложения больше этого размера не скачиваются:
# JIRA_MAX_ATTACHMENT_MB=100

# Папки от корня проекта:
# JIRA_DIR=_jira
# JIRA_EDIT_DIR=_jira-edit
